{
  "name": "watch2gether",
  "productName": "Watch2Gether",
  "version": "0.6.0",
  "description": "Watch local videos together in sync, streamed peer-to-peer over Tailscale.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node test/server.test.js && node test/updater.test.js && node test/hotkeys.test.js",
    "test:mpv": "node test/real-mpv.test.js",
    "dist": "electron-builder --win",
    "test:voice": "node test/voice-e2e/run.js",
    "test:hotkeys-real": "node test/hotkeys-real/run.js",
    "test:embed": "node test/embed/run.js",
    "test:app": "node test/app-e2e/run.js"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.7",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.watch2gether",
    "productName": "Watch2Gether",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/mpv",
        "to": "mpv",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Watch2Gether",
      "artifactName": "Watch2Gether-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kugelblitzz",
        "repo": "Watch2Gether"
      }
    ],
    "npmRebuild": false
  }
}
